# Resend (https://resend.com) — powers the "Request a Blink hub" and careers
# apply forms. Copy this file to .env.local and fill in your real key.
RESEND_API_KEY=

# Sender address for outgoing mail. Resend's shared sandbox sender
# (onboarding@resend.dev) only delivers to the email address on your Resend
# account, so it's fine for local testing but won't reach blinkhubltd@gmail.com
# in production — verify a domain in Resend and set a From address on it
# (e.g. "Blink <hello@yourdomain.com>") before launch.
RESEND_FROM_EMAIL="Blink <onboarding@resend.dev>"
